# MotionCraft AI - Free AI Image-to-Video Studio Configuration

# GEMINI_API_KEY: Optional Gemini API key for server-side AI logic
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# REPLICATE_API_KEY: Optional Replicate API token (r8_...) for Minimax Video-01, Kling, and Stable Video Diffusion
# Obtain free trial tokens at: https://replicate.com/account/api-tokens
# REPLICATE_API_KEY=r8_your_replicate_token_here

# FAL_KEY: Optional Fal.ai key for ultra-fast LTX and Kling video generation
# Obtain free developer key at: https://fal.ai/dashboard/keys
# FAL_KEY=your_fal_key_here

# HUGGINGFACE_TOKEN: Optional Hugging Face User Access Token (hf_...)
# Obtain free token at: https://huggingface.co/settings/tokens
# HUGGINGFACE_TOKEN=hf_your_token_here
